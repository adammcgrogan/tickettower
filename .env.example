# Branding
APP_NAME="Ticket Tower"
APP_ENV=development
# Set to "debug" for verbose logs. Warning: debug output includes the bot token.
LOG_LEVEL=info

# Infrastructure (Railway injects DATABASE_URL, REDIS_URL and PORT)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relay?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# The API's port. `make web` proxies /api to it.
PORT=8080
# Reverse proxies in front of the API (Railway's edge counts as 1). The per-IP
# login limit reads the client address from X-Forwarded-For past that many
# hops. Leave at 0 when nothing is in front, so forwarded headers are ignored.
TRUSTED_PROXIES=0

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: register slash commands to one server for instant updates in dev
DEV_GUILD_ID=
# Optional: your Discord user ID. Unlocks the /admin panel (install and usage
# stats across every server) for that user only.
SUPERADMIN_USER_ID=

# Public dashboard URL (https://tickettower.net in production). In dev this is the
# Vite server, which proxies /api.
# Add "$PUBLIC_URL/api/auth/callback" as an OAuth2 redirect in Discord.
PUBLIC_URL=http://localhost:5173
STATIC_DIR=web/build
